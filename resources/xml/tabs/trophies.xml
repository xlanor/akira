<brls:Box
    width="auto"
    height="auto"
    axis="column"
    grow="1.0">
    <PsnGatedBox
        id="trophies/gate"
        width="auto"
        height="auto"
        axis="column"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            marginTop="16"
            marginLeft="@style/brls/tab_frame/content_padding_sides"
            marginRight="@style/brls/tab_frame/content_padding_sides"
            marginBottom="8">

            <brls:Button
                id="trophies/sortBtn"
                text="@i18n/akira/trophies/sort_btn"
                style="bordered"
                marginRight="10"/>

            <brls:Button
                id="trophies/filterBtn"
                text="@i18n/akira/trophies/filter_btn"
                style="bordered"/>

            <brls:Box
                width="auto"
                height="auto"
                grow="1.0"/>

            <brls:Label
                id="trophies/status"
                text=""
                fontSize="15"
                marginRight="14"/>

            <brls:Button
                id="trophies/forceRefreshBtn"
                text="@i18n/akira/trophies/refresh"
                style="bordered"/>

        </brls:Box>

        <RecyclingGrid
            id="trophies/grid"
            width="auto"
            height="auto"
            grow="1.0"
            spanCount="1"
            itemHeight="332"
            itemSpace="18"
            paddingTop="4"
            paddingBottom="20"
            paddingLeft="@style/brls/tab_frame/content_padding_sides"
            paddingRight="@style/brls/tab_frame/content_padding_sides"/>

    </PsnGatedBox>

</brls:Box>
