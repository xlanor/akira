<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="@i18n/akira/settings/authentication"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="8"
                marginBottom="30"
                paddingTop="15"
                paddingBottom="15">

                <brls:InputCell
                    id="settings/companionHost"
                    title="@i18n/akira/settings/companion_host"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:InputCell
                    id="settings/companionPort"
                    title="@i18n/akira/settings/companion_port"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:Button
                    id="settings/fetchPsnBtn"
                    text="@i18n/akira/settings/fetch_psn_btn"
                    style="bordered"
                    grow="1"
                    marginLeft="15"
                    marginRight="15"
                    marginTop="10"
                    marginBottom="15"/>

                <brls:Button
                    id="settings/revealCredentials"
                    text="@i18n/akira/settings/reveal_secrets"
                    marginLeft="15"
                    marginRight="15"
                    marginTop="10"
                    marginBottom="10"/>

                <brls:InputCell
                    id="settings/psnAccountId"
                    title="@i18n/akira/settings/psn_account_id"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/credOnlineId"
                    focusable="false"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/credAccessToken"
                    focusable="false"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/credRefreshToken"
                    focusable="false"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/credTokenExpiry"
                    focusable="false"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/credDuid"
                    focusable="false"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    marginLeft="15"
                    marginRight="15"
                    marginTop="10"
                    marginBottom="15">

                    <brls:Button
                        id="settings/clearPsnBtn"
                        text="@i18n/akira/settings/clear_psn_data"
                        style="bordered"
                        grow="1"
                        marginRight="10"/>

                    <brls:Button
                        id="settings/refreshTokenBtn"
                        text="@i18n/akira/settings/refresh_token_btn"
                        style="bordered"
                        grow="1"/>

                </brls:Box>

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
