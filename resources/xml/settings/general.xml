<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="General"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="8"
                marginBottom="30">

                <brls:SelectorCell
                    id="settings/language"
                    title="@i18n/akira/settings/language"
                    marginLeft="15"
                    marginRight="15"/>


            </brls:Box>

            <brls:Header
                title="@i18n/akira/settings/performance"
                marginBottom="10"/>

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="8"
                marginBottom="30">

                <brls:BooleanCell
                    id="settings/enableThreadAffinity"
                    title="@i18n/akira/settings/thread_affinity"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:BooleanCell
                    id="settings/holepunchRetry"
                    title="@i18n/akira/settings/holepunch_retry"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:BooleanCell
                    id="settings/requestIdrOnFecFailure"
                    title="@i18n/akira/settings/request_idr"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SliderCell
                    id="settings/packetLossMax"
                    title="@i18n/akira/settings/packet_loss_max"
                    marginLeft="15"
                    marginRight="15"/>

            </brls:Box>

            <brls:Label
                id="settings/version"
                text="Akira v0.5.3"
                fontSize="16"
                textColor="#999999"
                marginTop="20"
                marginBottom="20"
                horizontalAlign="center"
                focusable="true"/>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
