<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="@i18n/akira/settings/controller"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="8"
                marginBottom="30">

                <brls:SelectorCell
                    id="settings/haptic"
                    title="@i18n/akira/settings/haptic_feedback"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SliderCell
                    id="settings/rumbleFreqLow"
                    title="@i18n/akira/settings/rumble_low_freq"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SliderCell
                    id="settings/rumbleFreqHigh"
                    title="@i18n/akira/settings/rumble_high_freq"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SliderCell
                    id="settings/rumbleEnvelopeAttack"
                    title="@i18n/akira/settings/rumble_attack"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SliderCell
                    id="settings/rumbleEnvelopeDecay"
                    title="@i18n/akira/settings/rumble_sustain"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:SelectorCell
                    id="settings/gyroSource"
                    title="@i18n/akira/settings/gyro_source"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:BooleanCell
                    id="settings/sleepOnExit"
                    title="@i18n/akira/settings/sleep_on_exit"
                    marginLeft="15"
                    marginRight="15"/>

                <brls:DetailCell
                    id="settings/buttonMapping"
                    title="@i18n/akira/settings/button_mapping"
                    marginLeft="15"
                    marginRight="15"/>

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
