<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                backgroundColor="@theme/color/card"
                cornerRadius="14"
                marginBottom="30">

                <brls:BooleanCell
                    id="settings/devFakeHosts"
                    title="@i18n/akira/settings/dev_fake_hosts"
                    marginLeft="15"
                    marginRight="15"/>

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
