<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="@i18n/akira/settings/power_user"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="14"
                marginBottom="30">

                <brls:BooleanCell
                    id="settings/unlockBitrateMax"
                    title="@i18n/akira/settings/unlock_bitrate_max"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/ipcStats"
                    title="@i18n/akira/settings/ipc_stats"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/portGuessing"
                    title="@i18n/akira/settings/port_guessing"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:SliderCell
                    id="settings/portGuessingCount"
                    title="@i18n/akira/settings/port_guess_count"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:SliderCell
                    id="settings/portGuessingSocks"
                    title="@i18n/akira/settings/probe_socket_count"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/autoReconnect"
                    title="@i18n/akira/settings/auto_reconnect"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:SliderCell
                    id="settings/psnRequestBudget"
                    title="@i18n/akira/settings/psn_request_budget"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:SliderCell
                    id="settings/psnRequestWindow"
                    title="@i18n/akira/settings/psn_request_window"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:Button
                    id="settings/runBenchmark"
                    text="@i18n/akira/settings/run_benchmark"
                    marginLeft="15"
                    marginRight="15"
                    marginTop="10"/>


            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
