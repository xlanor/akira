<brls:Box
    width="100%"
    height="100%"
    axis="column"
    backgroundColor="@theme/brls/background"
    paddingTop="30"
    paddingLeft="40"
    paddingRight="40"
    paddingBottom="30">

    <brls:Label
        text="@i18n/akira/settings/debug_logging"
        fontSize="30"
        marginBottom="20"/>

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0">

        <brls:Box
            width="auto"
            height="auto"
            axis="column">

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                grow="1.0"
                backgroundColor="@theme/color/card"
                cornerRadius="8"
                marginBottom="30">

                <brls:BooleanCell
                    id="settings/enableFileLogging"
                    title="@i18n/akira/settings/file_logging"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugLwipLog"
                    title="@i18n/akira/settings/lwip_log"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugWireguardLog"
                    title="@i18n/akira/settings/wireguard_log"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugRenderLog"
                    title="@i18n/akira/settings/render_log"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugChiakiLog"
                    title="@i18n/akira/settings/chiaki_log"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugDiscoveryLog"
                    title="@i18n/akira/settings/discovery_log"
                    marginLeft="15"
                    marginRight="15"/>


                <brls:BooleanCell
                    id="settings/debugFfmpegLog"
                    title="@i18n/akira/settings/ffmpeg_log"
                    marginLeft="15"
                    marginRight="15"/>


            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
