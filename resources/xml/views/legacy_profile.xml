<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="@theme/brls/background"
    paddingLeft="60"
    paddingRight="60">

    <brls:Label
        text="@i18n/akira/profile_setup/legacy_title"
        fontSize="30"
        horizontalAlign="center"/>

    <brls:Label
        text="@i18n/akira/profile_setup/legacy_intro"
        fontSize="16"
        horizontalAlign="center"
        textColor="@theme/brls/text_disabled"
        marginTop="10"
        marginBottom="26"
        width="700"/>

    <brls:Box
        id="legacy/fields"
        width="760"
        height="auto"
        axis="column"
        marginBottom="24"/>

    <brls:Button
        id="legacy/createBtn"
        text="@i18n/akira/profile_setup/create"
        style="primary"/>

</brls:Box>
