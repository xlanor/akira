<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="@theme/brls/background"
    paddingLeft="60"
    paddingRight="60">

    <brls:Label
        id="setup/glyph"
        fontSize="90"
        marginBottom="18"/>

    <brls:Label
        text="@i18n/akira/settings/setup_account"
        fontSize="34"
        horizontalAlign="center"/>

    <brls:Label
        text="@i18n/akira/settings/setup_account_hint"
        fontSize="18"
        horizontalAlign="center"
        textColor="#9aa0aa"
        marginTop="14"
        marginBottom="34"
        width="640"/>

    <brls:Button
        id="setup/startBtn"
        text="@i18n/akira/settings/setup_start_btn"
        style="primary"/>

</brls:Box>
