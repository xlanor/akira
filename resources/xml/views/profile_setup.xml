<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="@theme/brls/background"
    paddingLeft="60"
    paddingRight="60">

    <brls:Label
        id="setup/glyph"
        fontSize="72"
        marginBottom="14"/>

    <brls:Label
        text="@i18n/akira/profile_setup/title"
        fontSize="32"
        horizontalAlign="center"/>

    <brls:Label
        text="@i18n/akira/profile_setup/subtitle"
        fontSize="17"
        horizontalAlign="center"
        textColor="@theme/brls/text_disabled"
        marginTop="10"
        marginBottom="28"
        width="640"/>

    <brls:Box
        id="setup/options"
        width="760"
        height="auto"
        axis="column"/>

</brls:Box>
